# secrets / local config
.env
*.env
!.env.example

# runtime state (contains live account data)
data/
*.db
*.db-wal
*.db-shm

# build output
dist/
build/
# stray exe anywhere EXCEPT the vetted redistributables under static/downloads/
/*.exe
bridge/*.exe
# keep the clean, rebuilt bridge redistributables (no production domain baked in);
# they are also published on GitHub Releases with SHA256 checksums
!static/downloads/Forex_MT5_Copy_Sync_Bridge_Setup.exe
!static/downloads/forex-mt5-bridge-bundle.zip

# python
__pycache__/
*.py[cod]
.venv/
venv/

# installer runtime artifacts
service.log
service.pid
