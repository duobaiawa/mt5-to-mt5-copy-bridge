# Forex MT5 Copy Sync — TLS reverse proxy
# Closes SECURITY_AUDIT findings R-02 (no rate limiting) and R-03 (no TLS).
#
# The app binds 127.0.0.1:18197 and must NEVER be exposed directly.

# Rate limit for token-bearing endpoints: 10 req/s per IP, burst 20.
limit_req_zone $binary_remote_addr zone=mt5_mt5_bridge:10m rate=10r/s;

server {
    listen 80;
    server_name copy.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name copy.example.com;

    ssl_certificate     /etc/letsencrypt/live/copy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/copy.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # The console is a single self-contained page; keep uploads tiny.
    client_max_body_size 1m;

    location / {
        limit_req zone=mt5_mt5_bridge burst=20 nodelay;
        proxy_pass http://127.0.0.1:18197;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
