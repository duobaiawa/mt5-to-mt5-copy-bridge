# Forex MT5 Copy Sync — configuration
# Copy to .env and edit. app.py loads .env automatically; real environment
# variables always take precedence. NEVER commit .env.
#
# Quick start:  python scripts/init_env.py

# ============ authentication (REQUIRED) ============
# Console token, sent by the browser as the X-Admin-Token header.
FOREX_MT5_ADMIN_TOKEN=
# Bridge token, used by the Windows bridge agent (X-Bridge-Token header).
FOREX_MT5_BRIDGE_TOKEN=
# 1 disables ALL API auth. Local development on 127.0.0.1 only.
FOREX_MT5_DISABLE_AUTH=0

# ============ server ============
FOREX_MT5_COPY_HOST=127.0.0.1
FOREX_MT5_COPY_PORT=18197
FOREX_MT5_COPY_LOG_LEVEL=info
# Maximum rows any list endpoint will return.
FOREX_MT5_API_MAX_LIMIT=500

# ============ trading ============
# Default instrument used when the database has no setting yet.
# Per-instance source/executor symbols are edited in the console.
FOREX_MT5_COPY_SYMBOL=XAUUSD
# Prefix of the client_ref written into the MT5 order comment.
FOREX_MT5_CLIENT_REF_PREFIX=fxmt5

# ============ paths (optional) ============
# FOREX_MT5_COPY_DIR=/opt/mt5-to-mt5-copy-bridge
# FOREX_MT5_COPY_DATA_DIR=/opt/mt5-to-mt5-copy-bridge/data
# FOREX_MT5_COPY_DB=/opt/mt5-to-mt5-copy-bridge/data/state.db

# ============ MT5-side settings (not read by the server) ============
# These must match the EA inputs and the bridge agent parameters:
#   EA input  BridgeFolder  = Forex_MT5_Copy
#   agent     -BridgeFolder   Forex_MT5_Copy
# Change both together if you run two independent copy setups on one terminal.
